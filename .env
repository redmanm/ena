# Copy this file to .env.local and fill in the appropriate values

# DATABASE (PostgreSQL only)
# ==========================
DB_USER=postgres
DB_PASS=admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ena_visitors_db

DATABASE_URL=postgresql://neondb_owner:npg_l7U8WRDCLoTA@ep-broad-base-am4gjfts-pooler.c-5.us-east-1.aws.neon.tech/ena_visitors_db?sslmode=require&channel_binding=require
# Migrate / seed (Unix/macOS/Git Bash):
#   npm run db:migrate
#   npm run db:seed
# Windows PowerShell example:
#   $env:DATABASE_URL="postgresql://..."; psql $env:DATABASE_URL -f scripts/schema.sql

# SESSION / JWT
